/**
 * Fully overridden strict dark minimalist theme for Rofi
 */

* {
    bg:             #0d0f14;
    bg-selected:    #1f242c;
    fg:             #c9d1d9;
    fg-muted:       #8b949e;
    border-col:     #21262d;
    app-active:     #58a6ff;

    /* Override all built-in rofi variables to prevent solarized/white defaults */
    background:                  #0d0f14;
    foreground:                  #c9d1d9;
    normal-background:           transparent;
    normal-foreground:           #8b949e;
    alternate-normal-background: transparent;
    alternate-normal-foreground: #8b949e;
    selected-normal-background:  #1f242c;
    selected-normal-foreground:  #c9d1d9;

    active-background:           transparent;
    active-foreground:           #8b949e;
    alternate-active-background: transparent;
    alternate-active-foreground: #8b949e;
    selected-active-background:  #1f242c;
    selected-active-foreground:  #c9d1d9;

    urgent-background:           transparent;
    urgent-foreground:           #8b949e;
    alternate-urgent-background: transparent;
    alternate-urgent-foreground: #8b949e;
    selected-urgent-background:  #1f242c;
    selected-urgent-foreground:  #c9d1d9;

    background-color: transparent;
    text-color:       @fg;
    font:             "Hack 10";
}

window {
    background-color: @bg;
    border:           1px;
    border-color:     @border-col;
    border-radius:    0px;
    width:            560px;
    padding:          12px;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    spacing:          10px;
}

inputbar {
    background-color: @bg;
    border:           0px 0px 1px 0px;
    border-color:     @border-col;
    border-radius:    0px;
    padding:          6px 4px 10px 4px;
    children:         [ prompt, entry ];
    spacing:          8px;
}

prompt {
    text-color:       @fg-muted;
}

entry {
    placeholder:      "";
    text-color:       @fg;
}

listview {
    background-color: transparent;
    columns:          1;
    lines:            8;
    spacing:          2px;
    cycle:            true;
    dynamic:          true;
}

element {
    background-color: transparent;
    text-color:       @fg-muted;
    padding:          6px 8px;
    border-radius:    0px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg-muted;
}

element normal.active {
    background-color: transparent;
    text-color:       @app-active;
}

element normal.urgent {
    background-color: transparent;
    text-color:       #f85149;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @fg-muted;
}

element alternate.active {
    background-color: transparent;
    text-color:       @app-active;
}

element alternate.urgent {
    background-color: transparent;
    text-color:       #f85149;
}

element selected.normal {
    background-color: @bg-selected;
    text-color:       @fg;
}

element selected.active {
    background-color: @bg-selected;
    text-color:       @app-active;
}

element selected.urgent {
    background-color: @bg-selected;
    text-color:       @fg;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
}
